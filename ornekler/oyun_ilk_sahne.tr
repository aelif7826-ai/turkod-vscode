# Fareyi hareket ettirerek kameraya bak; WASD ile yürü, boşluk ile zıpla.
# Oyuncu varsa ve zemin yazılmamışsa geniş bir yeşil zemin otomatik eklenir.

içe_aktar Oyun

Oyun.sahne {
    oyuncu(
        konum: (0, 1, 0)
    )
    zemin(
        renk: yeşil
        konum: (0, -0.5, 0)
        boyut: (30, 1, 30)
    )
    küp(
        renk: turuncu
        konum: (0, 0, 4)
        boyut: (1, 1, 1)
        dönüş: (0, 25, 0)
        çarpışma: kutu
    )
    küre(
        renk: turkuaz
        konum: (2, 1, 4)
        boyut: (1, 1, 1)
        doku: "white_cube"
        çarpışma: yok
    )
}
