{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Uzantıyı Çalıştır",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extensions",
        "--disable-workspace-trust",
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "noDebug": true,
      "console": "internalConsole",
      "preLaunchTask": "Derle (tsc)"
    },
    {
      "name": "Uzantıyı Çalıştır (hata ayıklamalı)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extensions",
        "--disable-workspace-trust",
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "sourceMaps": true,
      "pauseForSourceMap": false,
      "console": "internalConsole",
      "preLaunchTask": "Derle (tsc)"
    }
  ]
}
